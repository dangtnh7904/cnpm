# ========================================
# DATABASE CONFIGURATION
# ========================================
# Thong tin ket noi SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=QuanLyChungCuDB
DB_USERNAME=sa
DB_PASSWORD=your_password_here

# ========================================
# JPA CONFIGURATION
# ========================================
JPA_SHOW_SQL=true

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8080

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=DEBUG
SQL_LOG_LEVEL=DEBUG

# ========================================
# JWT CONFIGURATION
# ========================================
# Secret key cho JWT (it nhat 32 ky tu)
JWT_SECRET=super-secret-demo-key-please-change-32bytes!!!!
JWT_EXPIRATION_MS=86400000

# ========================================
# VNPAY SANDBOX CONFIGURATION
# ========================================
# Dang ky tai: https://sandbox.vnpayment.vn/
# Sau khi dang ky, VNPAY se gui TMN_CODE va HASH_SECRET qua email
VNPAY_TMN_CODE=your_tmn_code_here
VNPAY_HASH_SECRET=your_hash_secret_here
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay-return
FRONTEND_URL=http://localhost:3000
